# Hunar Voice API
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# Apollo.io API (for Problem 2 - People Search)
APOLLO_API_KEY=

# Database
DATABASE_URL=sqlite:///./hunar.db

# Webhook Security
HUNAR_WEBHOOK_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Public HTTPS URL where Hunar can deliver webhooks (set this in production;
# e.g. the public URL of your deployed backend). Must be HTTPS.
HUNAR_WEBHOOK_URL=

# App
APP_NAME=Hunar Voice Agents API
DEBUG=true
